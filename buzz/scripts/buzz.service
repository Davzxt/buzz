[Unit]
Description=Buzz (HIVE) API
After=network.target

[Service]
WorkingDirectory=/opt/buzz
EnvironmentFile=/opt/buzz/.env
ExecStart=/opt/buzz/.venv/bin/uvicorn buzz.api:create_app --factory --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
MemoryMax=3G
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
